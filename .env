# ═══════════════════════════════════════════════════════════════════════════════
# p2 Production .env — High-Performance S3-Compatible Object Storage
# Optimized for append-only volume storage with maximum throughput
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────────────
P2_DJANGO_SETTINGS_MODULE=p2.core.settings

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
P2_SECRET_KEY=CHANGE-ME-generate-with-python-command-above

P2_DEBUG=false

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use 'redis' for Docker, '127.0.0.1' for local dev
P2_REDIS__HOST=redis
P2_REDIS__PASSWORD=
P2_REDIS__CACHE_DB=0
P2_REDIS__MESSAGE_QUEUE_DB=1
P2_REDIS__ARQ_URL=redis://redis:6379/1

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
P2_FERNET_KEY=CHANGE-ME-generate-with-python-command-above

# ── S3 ────────────────────────────────────────────────────────────────────────
# Base domain for virtual-hosted-style bucket URLs
# For path-style access (localhost:8787) leave as-is
P2_S3__BASE_DOMAIN=s3.example.com

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for blob payloads and LMDB metadata
# Docker: /storage (mapped volume). Local dev: ./storage
P2_STORAGE__ROOT=/storage

# Host path that Docker mounts into container at /storage
P2_HOST_STORAGE_ROOT=./storage

# Enable nginx zero-copy sendfile for GET operations (requires nginx proxy)
# Set to true in production with nginx, false for direct Granian serving
P2_STORAGE__USE_X_ACCEL_REDIRECT=true

# ═══════════════════════════════════════════════════════════════════════════════
# PERFORMANCE CRITICAL SETTINGS — Append-Only Storage Optimization
# ═══════════════════════════════════════════════════════════════════════════════

# ── LMDB Metadata Durability ──────────────────────────────────────────────────
# These control fsync behavior for LMDB metadata transactions
# 
# OPTIMIZED DEFAULTS (based on new append-only design):
# - Volume files already fsync data on batch commit (S3 durability guarantee)
# - LMDB index is rebuildable from volume scan after crash
# - Setting these FALSE removes redundant fsync without safety loss
# - Only set TRUE if you need LMDB itself to survive OS crash without rebuild
#
# Production (recommended): FALSE — faster, still durable via volume fsync
# Benchmarking: FALSE — maximum throughput
# Paranoia mode: TRUE — only if you cannot tolerate metadata rebuild after crash

P2_S3__METADATA__LMDB__SYNC=false
P2_S3__METADATA__LMDB__METASYNC=false

# ── Volume File Sync ──────────────────────────────────────────────────────────
# Controls fdatasync() on volume .bin files after each batch write
#
# TRUE (default): Data is durable on HTTP 200 (S3 semantics guaranteed)
# FALSE: Data sits in OS buffer cache (~30s flush window), faster but risk
#
# Production: TRUE — required for S3 durability guarantees
# Benchmarking only: FALSE — removes disk sync bottleneck

P2_S3__VOLUME__FDATASYNC=true

# ── Metadata Write Queue (Group Commit Batching) ─────────────────────────────
# Coalesces concurrent PUTs into batched LMDB transactions
# Critical for high concurrency — reduces writer-lock contention
#
# ENABLED: TRUE (always enable for append-only design)
# Batch size increased to 256 for better amortization
# Window set to 0ms — no artificial waiting, immediate drain

P2_S3__METADATA__WRITE_QUEUE__ENABLED=true
P2_S3__METADATA__WRITE_QUEUE__MAX_SIZE=16384
P2_S3__METADATA__WRITE_QUEUE__BATCH_SIZE=256
P2_S3__METADATA__WRITE_QUEUE__BATCH_WINDOW_MS=0.0

# ── In-Memory Caching ─────────────────────────────────────────────────────────
# TTL values for hot-path caches (seconds)
# Aggressive caching for auth/ACL checks, shorter for mutable metadata

P2_S3__CACHE__APIKEY_TTL_SECONDS=600
P2_S3__CACHE__VOLUME_TTL_SECONDS=600
P2_S3__CACHE__ACL_TTL_SECONDS=600
P2_S3__CACHE__VOLUME_PERMISSION_TTL_SECONDS=600
P2_S3__CACHE__METADATA_TTL_SECONDS=60
P2_S3__CACHE__PREFIX_TTL_SECONDS=30

# ── S3 Event Publishing ──────────────────────────────────────────────────────
# Publish blob-post-save events to Redis streams
# Enable only if you have downstream consumers (notifications, replication, etc.)

P2_S3__ASYNC_EVENT_PUBLISH=false

# Event queue batching (only used if ASYNC_EVENT_PUBLISH=true)
P2_S3__EVENT_QUEUE__ENABLED=false
P2_S3__EVENT_QUEUE__MAX_SIZE=8192
P2_S3__EVENT_QUEUE__BATCH_SIZE=64
P2_S3__EVENT_QUEUE__FLUSH_MS=5
P2_S3__EVENT_QUEUE__WAIT_FOR_ACK=false

# ── Blob Shard Depth ──────────────────────────────────────────────────────────
# Directory depth for object storage (1 or 2)
# Depth 2: XX/YY/UUID — better for millions of objects
# Depth 1: XX/UUID — simpler, fine for <1M objects per volume

P2_S3__BLOB__SHARD_DEPTH=2

# ── Compression (Optional) ────────────────────────────────────────────────────
# Enable for large objects to save storage space
# Disabled by default for maximum performance

P2_S3__COMPRESSION__ENABLED=false
P2_S3__COMPRESSION__MIN_SIZE=1048576
P2_S3__COMPRESSION__LEVEL=6

# ── Volume Pool Configuration ─────────────────────────────────────────────────
# Pre-allocated .bin file sizes and pool management

P2_STORAGE__VOLUME_SIZE_BYTES=10737418240
P2_STORAGE__VOLUME_ACTIVE_POOL_SIZE=4
P2_STORAGE__VOLUME_COMPACT_THRESHOLD=0.30

# ── Server ────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8787

# ── Observability ─────────────────────────────────────────────────────────────

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=p2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Security ──────────────────────────────────────────────────────────────────

P2_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],your-domain.com
P2_SECURITY__SSL_REDIRECT=false

# ═══════════════════════════════════════════════════════════════════════════════
# Performance Tuning Guide
# ═══════════════════════════════════════════════════════════════════════════════
#
# MAXIMUM THROUGHPUT (Benchmarking):
#   P2_S3__VOLUME__FDATASYNC=false
#   P2_S3__METADATA__LMDB__SYNC=false
#   → Expected: 5000+ PUT/s, 15000+ GET/s
#   ⚠ Risk: Up to 30s of writes lost on power failure

# PRODUCTION (Durable):
#   P2_S3__VOLUME__FDATASYNC=true  (default above)
#   P2_S3__METADATA__LMDB__SYNC=false  (safe: volume fsync ensures durability)
#   → Expected: 3000-4000 PUT/s, 12000+ GET/s
#   ✓ Safe: Data survives power failure

# PARANOIA MODE (Maximum Safety):
#   P2_S3__VOLUME__FDATASYNC=true
#   P2_S3__METADATA__LMDB__SYNC=true
#   P2_S3__METADATA__LMDB__METASYNC=true
#   → Expected: 1500-2000 PUT/s, 10000+ GET/s
#   ✓✓ Safest: Every fsync, minimal risk

# KEY OPTIMIZATIONS IN THIS CONFIG:
#   1. Write queue enabled with 256-item batches (reduces LMDB contention)
#   2. Zero batch window (no artificial latency)
#   3. LMDB sync disabled (volume fsync provides durability)
#   4. Aggressive caching for auth/ACL lookups
#   5. Event publishing disabled (enable only if needed)

# MONITORING:
#   Watch /metrics endpoint for:
#   - s3_put_latency_seconds (p50, p95, p99)
#   - s3_get_latency_seconds
#   - volume_write_queue_size
#   - lmdb_writer_lock_wait_seconds

# ═══════════════════════════════════════════════════════════════════════════════
