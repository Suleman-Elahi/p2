# p2 environment configuration
# Copy this file to .env and adjust values for your deployment.

# ── Core ──────────────────────────────────────────────────────────────────────

P2_DJANGO_SETTINGS_MODULE=p2.core.settings

# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
P2_SECRET_KEY=jut2C72jNpl0L5W8rA9r8_ZbwMkY2_TIJ5Zjr2K1r6qTzmWn6ZxzYjBnc3alzgrKzznxZ58Y28kjvDEysv6Kqw

P2_DEBUG=false

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use 'redis' for Docker, '127.0.0.1' for local dev.

P2_REDIS__HOST=redis
P2_REDIS__PASSWORD=
P2_REDIS__CACHE_DB=0
P2_REDIS__MESSAGE_QUEUE_DB=1
P2_REDIS__ARQ_URL=redis://redis:6379/1

# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED — encrypts API key secrets at rest (Fernet symmetric encryption).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

P2_FERNET_KEY=CHANGE-ME-generate-a-real-key

# ── S3 ────────────────────────────────────────────────────────────────────────

# Base domain for virtual-hosted-style bucket URLs.
# e.g. bucket "photos" → photos.s3.example.com
# For path-style access (--endpoint-url http://localhost:8787) leave as-is.
P2_S3__BASE_DOMAIN=s3.example.com

# ── Storage ───────────────────────────────────────────────────────────────────

# Root directory for blob payloads and LMDB metadata.
# Docker: /storage (mapped volume). Local dev: ./storage (relative to repo root).
P2_STORAGE__ROOT=/storage

# Host path that Docker mounts into the container at /storage.
# May be absolute or relative to the repo root.
P2_HOST_STORAGE_ROOT=./storage

# Let nginx serve blobs via X-Accel-Redirect (zero-copy sendfile).
# When true AND Nginx is proxying (X-Real-IP header present), Granian returns
# an empty 0-byte response with x-accel-redirect header. Nginx intercepts this
# and serves the file directly from disk using kernel sendfile().
# When Nginx is NOT detected (direct access to port 8787), the full file body
# is served regardless of this setting.
# Requires nginx to be configured. Leave false for pure-Python serving.
P2_STORAGE__USE_X_ACCEL_REDIRECT=false

# ── LMDB Metadata ────────────────────────────────────────────────────────────
# These knobs trade metadata durability for PUT throughput. LMDB never corrupts
# — at worst you lose the last few writes on an OS crash / power failure.

# fsync() after every metadata write transaction.
#   true  = durable (safe for production). Each PUT waits for disk flush.
#   false = fast. Data sits in OS buffer cache, flushed to disk ~every 30 s.
# Expected impact on 4 KiB PUTs: true ≈ 1 400 obj/s, false ≈ 3 500 obj/s.
P2_S3__METADATA__LMDB__SYNC=true

# fsync() only on metadata page renames (less critical than data sync).
#   true  = safe default, follows sync above.
#   false = further reduces disk I/O under heavy write concurrency.
P2_S3__METADATA__LMDB__METASYNC=true

# ── Metadata Write Queue ─────────────────────────────────────────────────────
# Coalesces concurrent PUTs into batched LMDB transactions instead of one
# transaction per PUT. Under high concurrency this can reduce LMDB writer-lock
# contention and amortise any remaining fsync cost across multiple writes.

# Enable the in-process batching queue.
#   true  = batch writes, single LMDB txn per batch → higher throughput.
#   false = one LMDB txn per PUT → lower latency for light workloads.
P2_S3__METADATA__WRITE_QUEUE__ENABLED=false

# Maximum items in the queue before falling back to direct (unbatched) writes.
P2_S3__METADATA__WRITE_QUEUE__MAX_SIZE=8192

# Maximum items to commit in a single LMDB transaction.
P2_S3__METADATA__WRITE_QUEUE__BATCH_SIZE=64

# Max milliseconds to wait for more items when only 1 is queued. 0 = no wait.
P2_S3__METADATA__WRITE_QUEUE__BATCH_WINDOW_MS=5.0

# ── S3 Event Publishing ──────────────────────────────────────────────────────

# Publish blob-post-save events for downstream consumers (Redis streams).
#   true  = fire-and-forget (asyncio.create_task). Non-blocking.
#   false = events are NOT published. Fastest path if you don't need them.
P2_S3__ASYNC_EVENT_PUBLISH=false

# Optional bounded queue for Redis Stream publishing.
# When enabled, events are pushed through an in-process queue with batching
# instead of creating a new Redis connection per event.
P2_S3__EVENT_QUEUE__ENABLED=false
P2_S3__EVENT_QUEUE__MAX_SIZE=8192
P2_S3__EVENT_QUEUE__BATCH_SIZE=64
P2_S3__EVENT_QUEUE__FLUSH_MS=5
P2_S3__EVENT_QUEUE__WAIT_FOR_ACK=false

# Blob shard directory depth (1 or 2). Depth 2 creates dirs like XX/YY/UUID
# to spread files across more directories, reducing per-directory inode pressure
# at petabyte scale. Depth 1 is simpler but may slow down at extreme object counts.
P2_S3__BLOB__SHARD_DEPTH=2

# ═══════════════════════════════════════════════════════════════════════════════
# Performance Quick-Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# Production (safe, durable):
#   P2_S3__METADATA__LMDB__SYNC=true
#   P2_S3__METADATA__LMDB__METASYNC=true
#   P2_S3__METADATA__WRITE_QUEUE__ENABLED=false
#   → ~1 400 PUT obj/s, data survives power loss
#
# Benchmarking (fast, relaxed):
#   P2_S3__METADATA__LMDB__SYNC=false
#   P2_S3__METADATA__LMDB__METASYNC=false
#   P2_S3__METADATA__WRITE_QUEUE__ENABLED=true
#   P2_S3__ASYNC_EVENT_PUBLISH=true
#   → ~3 500+ PUT obj/s, up to ~30 s of writes at risk on OS crash
#
# ⚠ Config key naming: double underscores (__) separate hierarchy levels.
#   P2_S3__METADATA__LMDB__SYNC  →  s3.metadata.lmdb.sync  ✅
#   P2_S3_METADATA__LMDB__SYNC   →  s3_metadata.lmdb.sync  ❌ (won't apply)

# ── Observability (optional) ──────────────────────────────────────────────────

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=p2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Server ────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8787
