.pytest_cache/
.mypy_cache/
.hypothesis/
static
# Secrets — .env holds P2_SECRET_KEY and P2_FERNET_KEY. Never commit it.
# .env.example is the tracked template.
.env
.env.*
!.env.example

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal
*.db

# ASGI
.asgi/

# Object storage data directories.
# These were previously listed as bare `s3/` and `volume_writer/`, which git
# matches at ANY depth — `s3/` silently ignored the entire `p2/s3/` application
# package. Leading slashes anchor them to the repo root, where the data actually
# lives.
/s3/
/volume_writer/
/storage/

# Compiled Rust extensions.
# Built artifacts are installed into .venv by the ext build.sh scripts and must
# not be committed. A checked-in .so becomes a second loadable copy of the
# extension that drifts out of sync with its Rust source — see p2/s3/_native.py.
*.so
*.bak
p2/s3/*/dist/
p2/s3/*/target/

# Benchmark output
warp-*.json.zst

# Frontend (ui/) — Vite/Vue build artifacts and dependencies.
ui/node_modules/
ui/dist/
